<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:id="@+id/tvPropFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <!-- 1. FILE SPECIFICATIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILE INFORMATION"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="1">

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Size:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvPropSize"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Resolution:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvPropResolution"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Type / Format:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvPropMime"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Modified:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvPropDate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Location / Path:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvPropPath"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </TableRow>
        </TableLayout>

        <!-- 2. VIDEO SPECIFICATIONS -->
        <TextView
            android:id="@+id/tvHeaderVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="VIDEO SPECIFICATIONS &amp; STREAM"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TableLayout
            android:id="@+id/tableVideoExif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="1"
            android:visibility="gone">

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Duration:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoDuration"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Bitrate:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoBitrate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Video Codec:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoCodec"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Audio:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoAudio"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Orientation:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoOrientation"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Recorded Date:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvVideoDate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

        </TableLayout>

        <!-- 3. CAMERA & OPTICS (EXIF) -->
        <TextView
            android:id="@+id/tvHeaderCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CAMERA &amp; SHOT DETAILS (EXIF)"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TableLayout
            android:id="@+id/tableCameraExif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="1">

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Camera Device:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifCamera"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Date &amp; Time:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifDateTaken"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Aperture:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifAperture"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Shutter Speed:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifShutter"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="ISO Speed:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifIso"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Focal Length:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifFocal"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="Flash:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifFlash"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="White Balance:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifWb"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow android:paddingVertical="3dp">
                <TextView
                    android:layout_width="120dp"
                    android:text="GPS Location:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvExifLocation"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />
            </TableRow>

        </TableLayout>

        <!-- General EXIF Text Fallback -->
        <TextView
            android:id="@+id/tvPropExif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
