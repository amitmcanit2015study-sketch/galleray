<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="#FFFFFF"
            app:title="@string/collage_title"
            app:titleTextColor="#FFFFFF">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCollage"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:text="Save"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:cornerRadius="21dp"
                app:backgroundTint="#0088FF"
                app:icon="@drawable/ic_check"
                app:iconTint="#FFFFFF"
                app:iconSize="18dp"
                app:iconGravity="textStart" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Hint banner -->
        <TextView
            android:id="@+id/tvSwapHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1AFFFFFF"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="Tap image to edit/rotate/filter or tap two to swap"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <!-- Collage Preview Canvas Container -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp">

            <com.amitbharat.gallery.ui.custom.CollageView
                android:id="@+id/collageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Contextual Selected Tile Action Bar -->
        <LinearLayout
            android:id="@+id/layoutTileActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#263238"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSelectedTileLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="Image 1 Selected"
                android:textColor="#80D8FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnRotateTile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rotate"
                android:src="@drawable/ic_rotate"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnFlipHTile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Flip Horizontal"
                android:src="@drawable/ic_flip_horizontal"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnFlipVTile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Flip Vertical"
                android:src="@drawable/ic_flip_vertical"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnZoomInTile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom In"
                android:src="@drawable/ic_aspect_ratio"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnCloseTileAction"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Deselect"
                android:src="@drawable/ic_close"
                app:tint="#FF8A80" />

        </LinearLayout>

        <!-- Bottom Controls Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Control Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabCollageOptions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E1E1E"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextColor="#A0A0A0">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Layout" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ratio" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Border" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filters" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text &amp; Stickers" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doodle" />

            </com.google.android.material.tabs.TabLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E2E2E" />

            <!-- Tab 0: Layout Templates -->
            <HorizontalScrollView
                android:id="@+id/sectionLayouts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLayouts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Tab 1: Aspect Ratio -->
            <HorizontalScrollView
                android:id="@+id/sectionRatios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRatios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRatio1_1"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="1:1 Square"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRatio4_5"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:5 Portrait"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRatio3_4"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3:4 Standard"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRatio16_9"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9 Landscape"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRatio9_16"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:16 Story"
                        android:textColor="#FFFFFF" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Tab 2: Border & Padding Sliders -->
            <LinearLayout
                android:id="@+id/sectionBorders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <!-- Inner Spacing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Inner Spacing"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderInnerPadding"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:value="6"
                        android:valueFrom="0"
                        android:valueTo="24"
                        android:stepSize="1" />
                </LinearLayout>

                <!-- Outer Margin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Outer Margin"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderOuterMargin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:value="8"
                        android:valueFrom="0"
                        android:valueTo="24"
                        android:stepSize="1" />
                </LinearLayout>

                <!-- Corner Radius -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Corner Radius"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCornerRadius"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:value="10"
                        android:valueFrom="0"
                        android:valueTo="32"
                        android:stepSize="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- Tab 3: Background Colors & Gradients -->
            <LinearLayout
                android:id="@+id/sectionColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:text="Solid Colors"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupColors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="16dp"
                    android:text="Modern Gradients"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGradients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Tab 4: Filters (Applied to selected tile or all) -->
            <HorizontalScrollView
                android:id="@+id/sectionFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterOriginal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Original"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAuto"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Enhance"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterVivid"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vivid"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterBW"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="B &amp; W"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterWarm"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warm Glow"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCool"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cool Nordic"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterVintage"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vintage"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterDramatic"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dramatic"
                        android:textColor="#FFFFFF" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Tab 5: Text & Stickers -->
            <LinearLayout
                android:id="@+id/sectionTextStickers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddText"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+ Add Text"
                        android:textColor="#FFFFFF"
                        app:strokeColor="?attr/colorPrimary" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drag items on canvas to place"
                        android:textColor="#80D8FF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to Add Emoji / Sticker:"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupStickers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Tab 6: Doodle Brush -->
            <LinearLayout
                android:id="@+id/sectionDoodle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Draw on canvas with finger"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUndoDoodle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Undo"
                        android:textColor="#80D8FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearDoodle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textColor="#FF8A80" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDoodleColors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
