<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy Storage Permissions for Android 12 and below (API <= 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Modern Granular Media Permissions for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 14+ (API 34+) Partial / User Selected Media Access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Full Storage Management for File Manager operations on Android 11+ -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Wallpaper permission for Image Viewer -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:name=".GalleryApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/file_paths"
        android:fullBackupContent="@xml/file_paths"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gallery"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Gallery.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Home Screen (Gallery & File Manager) -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Folder / Album Detail Screen -->
        <activity
            android:name=".ui.activities.FolderDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Image Viewer (Pinch-zoom, Slideshow, Info) -->
        <activity
            android:name=".ui.activities.ImageViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Image Crop & Transform Tool -->
        <activity
            android:name=".ui.activities.ImageCropActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Photo Collage Maker Tool -->
        <activity
            android:name=".ui.activities.CollageMakerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Video Player (ExoPlayer with gesture controls, PiP) -->
        <activity
            android:name=".ui.activities.VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Video Trim & Cutter Tool -->
        <activity
            android:name=".ui.activities.VideoTrimActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Storage Analyzer & Cleaner -->
        <activity
            android:name=".ui.activities.StorageAnalyzerActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Secure Vault / Hidden Folder -->
        <activity
            android:name=".ui.activities.SecureVaultActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Recycle Bin / Trash Activity -->
        <activity
            android:name=".ui.activities.RecycleBinActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Global Search & Filter -->
        <activity
            android:name=".ui.activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- About Screen -->
        <activity
            android:name=".ui.activities.AboutActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Secure FileProvider for Sharing Media and Files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
