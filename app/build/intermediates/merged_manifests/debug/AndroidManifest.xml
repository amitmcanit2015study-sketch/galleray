<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amitbharat.gallery"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="34" />

    <!-- Modern Granular Media Permissions for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Android 14+ (API 34+) Partial / User Selected Media Access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Android 13+ Notification Permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Full Storage Management for File Manager operations on Android 13+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Wallpaper permission for Image Viewer -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.amitbharat.gallery.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.amitbharat.gallery.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.amitbharat.gallery.GalleryApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/file_paths"
        android:debuggable="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/file_paths"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gallery" >

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Gallery.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Home Screen (Gallery & File Manager) -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Folder / Album Detail Screen -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.FolderDetailActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- Image Viewer (Pinch-zoom, Slideshow, Info) -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.ImageViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Image Crop & Transform Tool -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.ImageCropActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Video Player (ExoPlayer with gesture controls, PiP) -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Video Trim & Cutter Tool -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.VideoTrimActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false"
            android:theme="@style/Theme.Gallery.MediaViewer" />

        <!-- Storage Analyzer & Cleaner -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.StorageAnalyzerActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- Secure Vault / Hidden Folder -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.SecureVaultActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- Recycle Bin / Trash Activity -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.RecycleBinActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- Global Search & Filter -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- About Screen -->
        <activity
            android:name="com.amitbharat.gallery.ui.activities.AboutActivity"
            android:exported="false"
            android:parentActivityName="com.amitbharat.gallery.ui.activities.MainActivity" />

        <!-- Secure FileProvider for Sharing Media and Files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.amitbharat.gallery.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.amitbharat.gallery.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>