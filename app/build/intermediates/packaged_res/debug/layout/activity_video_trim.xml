<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0F14">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#16171E"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="#FFFFFF"
        app:title="Trim &amp; Cut Video"
        app:titleTextColor="#FFFFFF"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTrim"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:text="Export"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#3B50DF"
            app:cornerRadius="20dp"
            app:elevation="2dp" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Video Preview View -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@+id/trimControlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit" />

        <ImageButton
            android:id="@+id/btnPlayPausePreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_selection_circle"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFF"
            android:contentDescription="Play Preview" />

        <!-- Exporting Progress Overlay -->
        <LinearLayout
            android:id="@+id/layoutExportProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBarExport"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/tvExportProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Trimming video... 0%"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- Trim Control Panel -->
    <LinearLayout
        android:id="@+id/trimControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16171E"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Trim Range Duration Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentPlayhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play: 00:00"
                android:textColor="#D0D0DA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTrimDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Selected: 00:00 - 00:00 (0s)"
                android:textColor="#3B50DF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Video Playback Seekbar -->
        <SeekBar
            android:id="@+id/seekBarVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="1000" />

        <!-- Dual Start / End Time Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- From (Start Time) Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#242634"
                app:strokeColor="#3F4257"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="START TIME (FROM)"
                        android:textColor="#9E9EAF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartMinus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="-1s"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#323447"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartPlus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+1s"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#323447"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetStart"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Set Current"
                        android:textColor="#3B50DF"
                        android:textSize="11sp"
                        app:strokeColor="#3B50DF"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- To (End Time) Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#242634"
                app:strokeColor="#3F4257"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="END TIME (TO)"
                        android:textColor="#9E9EAF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndMinus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="-1s"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#323447"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndPlus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+1s"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#323447"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetEnd"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Set Current"
                        android:textColor="#3B50DF"
                        android:textSize="11sp"
                        app:strokeColor="#3B50DF"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Preview Trim Range Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewTrimRange"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="Play Selected Range"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#2D3043"
            app:icon="@drawable/ic_play"
            app:iconTint="#FFFFFF"
            app:iconSize="18dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
